type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = nat;
type Result__1 = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Result_2 = 
 variant {
   err: Error;
   ok;
 };
type Result_1 = 
 variant {
   err: CompositionError;
   ok;
 };
type Result = 
 variant {
   err: CompositionError;
   ok: CompositionView;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type CompositionView = 
 record {
   createdAt: Timestamp;
   id: nat;
   name: text;
   payload: text;
   updatedAt: Timestamp;
 };
type CompositionError = 
 variant {
   invalidName;
   notAuthorized;
   notFound: nat;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result_2);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  /// Delete one of the caller's saved compositions.
  deleteComposition: (id: nat) -> (Result_1);
  execute: (qJson: text) -> (Result__1) query;
  /// Return the backend's public API documentation as Markdown.
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  /// Fetch one of the caller's saved compositions by id.
  getComposition: (id: nat) -> (opt CompositionView) query;
  isCallerAdmin: () -> (bool) query;
  /// List the caller's saved compositions, newest first.
  listCompositions: () -> (vec CompositionView) query;
  /// Save a new composition for the caller.
  saveComposition: (name: text, payload: text) -> (Result);
  schema: () -> (text) query;
  /// Update an existing composition owned by the caller.
  updateComposition: (id: nat, name: text, payload: text) -> (Result);
}
